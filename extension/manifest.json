{
  "manifest_version": 3,
  "name": "SubSnap — 1-Click Subscription Canceller",
  "version": "1.0.0",
  "description": "Instant 1-click subscription cancellation with privacy-first AI assistance.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SubSnap — Cancel Any Subscription",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
